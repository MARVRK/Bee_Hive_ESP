// secrets.h.example
// Скопируйте этот файл в secrets.h и заполните своими данными
// secrets.h НЕ будет закоммичен в Git (он в .gitignore)

#ifndef SECRETS_H
#define SECRETS_H

// WiFi настройки
#define WIFI_SSID "your_wifi_ssid"
#define WIFI_PASSWORD "your_wifi_password"

// Telegram Bot
#define TELEGRAM_BOT_TOKEN "1234567890:ABCdefGHIjklMNOpqrsTUVwxyz"
#define TELEGRAM_CHAT_ID "your_chat_id"

// APN настройки для A7670E (зависит от оператора)
#define GPRS_APN "internet"           // Например: "internet.mts.ru"
#define GPRS_USER ""                  // Обычно пусто
#define GPRS_PASSWORD ""              // Обычно пусто

// Калибровка HX711 (заполните после калибровки)
#define HX711_CALIBRATION_FACTOR -7050  // Подберите свой
#define HX711_OFFSET 50682624L           // Tare значение

#endif // SECRETS_H
